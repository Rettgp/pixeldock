<?xml version="1.0" encoding="utf-8"?>
<!--
  Reference copy of the SignPath artifact configuration for PixelDock.
  The publish workflow uploads a GitHub artifact (a zip) containing only the
  NSIS installer; this tells SignPath to Authenticode-sign that installer.
  Paste it into the project's artifact configuration on signpath.io.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="PixelDock-Setup-*.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
